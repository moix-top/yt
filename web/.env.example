# Cópialo a .env.local para dev, o configúralo en Vercel. Sin claves de AWS la
# app usa un almacén en memoria (funciona, pero no persiste).
AWS_REGION=eu-west-1
DYNAMODB_TABLE=yt-data
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Login con Google (Auth.js v5). openssl rand -base64 32
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_TRUST_HOST=true
# ⚠️  NO definas AUTH_URL. Redirect URIs en Google Cloud:
#   https://yt.moix.top/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google

# Solo `npm run dev`: botón para entrar sin Google con este email.
# DEV_LOGIN_EMAIL=yo@example.com

# Descargas de listas (yt-dlp). Activas siempre en `npm run dev`; en un
# `next start` propio, con NEXT_PUBLIC_DOWNLOADS=1. Nunca en Vercel.
# NEXT_PUBLIC_DOWNLOADS=1
# DOWNLOADS_DIR=/home/yo/Música/yt     # por defecto ~/Descargas/yt
# YTDLP_BIN=/ruta/a/yt-dlp             # por defecto web/.bin/yt-dlp o el del sistema
# Listas privadas («Me gusta», list=LM): sesión de YouTube del navegador donde la
# tengas iniciada (brave, chrome, firefox…), o un cookies.txt. Solo se usa con
# las listas que sin sesión no se ven. Mejor elígelo en la página de Descargas
# (navegador + perfil); esto solo vale mientras no se haya guardado nada allí.
# YTDLP_COOKIES_FROM_BROWSER=brave
# YTDLP_COOKIES=/ruta/a/cookies.txt
